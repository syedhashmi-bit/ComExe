# build artifacts — the image build runs `npm run build` itself, so any
# pre-existing .next/ in the working directory is irrelevant.
.next
node_modules
npm-debug.log
tsconfig.tsbuildinfo

# version control
.git
.gitignore

# docker meta
Dockerfile
.dockerignore
docker-compose*.yml

# CI
.github

# local dev / private notes (not needed at runtime, never sensitive in repo)
*.md
.env*
.claude
Read-Prompt.txt
gh

# runtime state — must never be baked into the image. A local dev
# data/config.json would ship real credentials inside the published layer,
# and would also shadow the mounted volume at /app/data. The Dockerfile
# creates an empty /app/data owned by uid 1001 instead.
data
.playwright-mcp
