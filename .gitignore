# dependencies
node_modules/
.pnp
.pnp.js

# next.js — builds happen in CI (GitHub Actions) which doesn't hit the SIGSEGV
# issue some TrueNAS hosts have, so the production image is pulled from GHCR
# rather than built per-host. Local dev still produces .next/ — we just don't
# track it.
.next/
out/

# claude code
.claude/

# local development / private notes
# CLAUDE.md, context.md, memory.md, skills.md are tracked because they document
# the project for future Claude Code sessions and are scrubbed of secrets.
Read-Prompt.txt
gh

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime state — NEVER commit. data/config.json holds plaintext API keys and
# passwords for every upstream service (written by the /setup wizard, mode 0600).
# Also: history.jsonl, bookmarks.json, custom-cards.json, alerts.json,
# servers.json, dependencies.json. All created on demand at runtime — the
# Dockerfile and json-store.ts both mkdir -p this directory themselves.
data/

# playwright-mcp session artifacts (screenshots, console logs, a11y snapshots)
.playwright-mcp/
